/* Expected output: 0  0  40  15  10  1  0  1  90  6  77
 * Edge cases of the for loop that t4_02 and t4_04 do not cover:
 * empty header parts, a body with no braces, a loop that never runs,
 * a counting-down loop, relational precedence, a for loop inside a
 * function that is called from inside another for loop, and for (;;). */

int data[4];

/* A for loop in a callee: the caller's loop must survive the call,
 * which exercises the register flush before jal and at every label. */
int sum(int a[], int n) {
    int i; int s;
    s = 0;
    for (i = 0; i < n; i = i + 1) s = s + a[i];
    return s;
}

int main() {
    int i; int s; int a; int b; int t;

    /* no init and no update: only the condition */
    i = 3;
    for (; i > 0; ) i = i - 1;
    print(i);                       /* 0 */

    /* condition false on entry: the body runs zero times */
    s = 0;
    for (i = 5; i < 5; i = i + 1) s = s + 100;
    print(s);                       /* 0 */

    /* != as the condition, body without braces */
    for (i = 0; i != 4; i = i + 1) s = s + 10;
    print(s);                       /* 40 */

    /* counting down with >= */
    s = 0;
    for (i = 5; i >= 1; i = i - 1) { s = s + i; }
    print(s);                       /* 5+4+3+2+1 = 15 */

    /* the loop variable keeps its final value after the loop */
    for (i = 0; i <= 9; i = i + 1) { }
    print(i);                       /* 10 */

    /* relational operators bind looser than arithmetic, == looser than < */
    a = 2; b = 3;
    print(a + 1 < b * 2);           /* 3 < 6        -> 1 */
    print(a < b == b < a);          /* 1 == 0       -> 0 */
    print(a * 2 >= b + 1);          /* 4 >= 4       -> 1 */

    /* calling a function that has its own for loop, from inside a loop */
    for (i = 0; i < 4; i = i + 1) data[i] = (i + 1) * 10;
    t = 0;
    for (i = 0; i < 2; i = i + 1) t = t + sum(data, 2 + i);
    print(t);                       /* (10+20) + (10+20+30) = 90 */

    /* nested loops sharing one accumulator, inner bound depends on outer */
    s = 0;
    for (a = 1; a <= 3; a = a + 1)
        for (b = 1; b <= a; b = b + 1)
            s = s + 1;
    print(s);                       /* 1 + 2 + 3 = 6 */

    /* for (;;) never tests anything; return is the only way out until
     * break exists */
    for (;;) {
        print(77);
        return 0;
    }
    print(999);                     /* never printed */
    return 0;
}
