/* A realistic program using every construct of the language.
 * Expect: 0 errors — CERTIFIED LEXICALLY CORRECT, exit status 0. */
int values[10];
int total;

int sum(int n) {
    int i;
    int acc;
    acc = 0;
    for (i = 0; i < n; i = i + 1) {
        if (values[i] >= 0 && values[i] <= 100) {
            acc = acc + values[i];
        } else {
            acc = acc - 1;
        }
    }
    return acc;
}

int main() {
    int k;
    k = 0;
    while (k != 10) { values[k] = k * 2; k = k + 1; }
    total = sum(10);
    switch (total) {
        case 90: print(total); break;
        default: print(0 - 1); break;
    }
    if (!(total == 90) || total > 1000) { print(total / 2); }
    return 0;
}
